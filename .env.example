APP_BASE_URL=http://localhost:3000

# Brug auto lokalt: Azure Table Storage bruges, hvis credentials findes,
# ellers falder appen tilbage til en lokal udviklingsfil.
ORD_STORAGE_MODE=auto
ORD_DEV_AUTH=true
ORD_IMPORT_DANNET=false
ORD_DANNET_URL=https://wordnet.dk/export/csv/dn

# Auth0
AUTH0_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Azure Table Storage
AZURE_TABLE_NAME=OrdUserData
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCESS_KEY=
